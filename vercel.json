{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/video/:path*",
      "destination": "https://xperience.realestate/trecasa/anna/onepager/video/:path*"
    },
    {
      "source": "/foto/:path*",
      "destination": "https://xperience.realestate/trecasa/anna/onepager/foto/:path*"
    },
    {
      "source": "/((?!video/|foto/).*)",
      "destination": "/index.html"
    }
  ]
}